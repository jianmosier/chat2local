{
  "name": "chat2local",
  "version": "0.1.0-alpha.30",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <27"
  },
  "scripts": {
    "build:rust:controller": "node scripts/build-rust-controller.mjs",
    "test:rust:controller": "node scripts/test-rust-controller.mjs",
    "build:rust-transport": "node scripts/build-rust-transport.mjs",
    "test:rust-transport": "node scripts/test-rust-transport.mjs",
    "build:rust-json-compat": "node scripts/build-rust-json-compat.mjs",
    "test:rust-json-compat": "node scripts/test-rust-json-compat.mjs",
    "build:rust-lifecycle": "node scripts/build-rust-lifecycle.mjs",
    "test:rust-lifecycle": "node scripts/test-rust-lifecycle.mjs",
    "build:rust-native-store": "node scripts/build-rust-native-store.mjs",
    "test:rust-native-store": "node scripts/test-rust-native-store.mjs",
    "build:rust-terminal-store": "node scripts/build-rust-terminal-store.mjs",
    "test:rust-terminal-store": "node scripts/test-rust-terminal-store.mjs",
    "build:rust-relay": "node scripts/build-rust-relay.mjs",
    "test:rust-device": "node scripts/test-rust-device.mjs",
    "test:rust-registry": "node scripts/test-rust-registry.mjs",
    "build:rust-terminal": "node scripts/build-rust-terminal.mjs",
    "test:rust-terminal": "node scripts/test-rust-terminal.mjs",
    "build:rust-operations": "node scripts/build-rust-operations.mjs",
    "test:rust-operations": "node scripts/test-rust-operations.mjs",
    "build:rust-writer": "node scripts/build-rust-writer.mjs",
    "test:rust-writer": "node scripts/test-rust-writer.mjs",
    "build:rust-readonly": "node scripts/build-rust-readonly.mjs",
    "test:rust-readonly": "node scripts/test-rust-readonly.mjs",
    "test:rust": "node scripts/test-rust-readonly.mjs",
    "release": "node --use-env-proxy scripts/release.mjs",
    "test:terminal": "node --test --test-concurrency=1 tests/terminal.test.mjs tests/existing-connection-http.test.mjs",
    "test:release": "node --test --test-concurrency=1 tests/release.test.mjs tests/public-release.test.mjs",
    "setup": "node --use-env-proxy scripts/setup-selfhost.mjs",
    "manage": "node scripts/launch.mjs --manage",
    "build:public": "node scripts/build-public.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "test:ui": "node --test --test-concurrency=1 tests/folders-ui.test.mjs tests/private-instance-http.test.mjs",
    "test:management": "node --test --test-concurrency=1 tests/public-release.test.mjs tests/private-instance-http.test.mjs tests/existing-connection.test.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:reconnect": "node --test --test-concurrency=1 tests/existing-connection.test.mjs tests/existing-connection-http.test.mjs",
    "test:installer-entry": "node --test --test-concurrency=1 tests/install-portal.test.mjs tests/install-entry.test.mjs tests/installer-main.test.mjs tests/private-instance-http.test.mjs",
    "setup:installer-password": "node --use-env-proxy --import ./scripts/maintainer-tls-compat.mjs scripts/setup-installer-password.mjs",
    "test:private-instance": "node --test --test-concurrency=1 tests/private-instance.test.mjs tests/private-instance-http.test.mjs tests/instance-installer.test.mjs",
    "test:multi-device": "node --test --test-concurrency=1 tests/device-routing.test.mjs tests/multi-device.test.mjs",
    "test:accounts": "node --test --test-concurrency=1 tests/account-connections.test.mjs tests/account-transport.test.mjs tests/one-consent.test.mjs tests/oidc-login.test.mjs tests/onboarding-session.test.mjs tests/account-onboarding-http.test.mjs tests/account-entry.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test",
    "start": "node scripts/launch.mjs",
    "build:windows": "node --use-env-proxy scripts/build-portable.mjs --target win32-x64",
    "build:portable": "node --use-env-proxy scripts/build-portable.mjs",
    "build:installers": "node scripts/build-installers.mjs",
    "test:cross-platform": "node --test --test-concurrency=1 tests/platform.test.mjs tests/installer.test.mjs tests/installer-preflight.test.mjs",
    "test:portable": "node scripts/test-portable.mjs",
    "check:relay": "wrangler deploy --dry-run --outdir .artifacts/relay-build",
    "preview:portable": ".\\dist\\Chat2Local-Windows-x64\\runtime\\node.exe .\\dist\\Chat2Local-Windows-x64\\scripts\\launch.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "esbuild": "0.28.1",
    "miniflare": "5.20260918.0-alpha",
    "oauth4webapi": "3.8.8",
    "playwright-core": "1.63.0",
    "wrangler": "4.135.0"
  }
}
